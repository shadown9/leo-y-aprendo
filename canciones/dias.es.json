{
 "lines": [
  {
   "t": 8.02,
   "text": "Lunes, martes, miércoles"
  },
  {
   "t": 10.66,
   "text": "Jueves, viernes también"
  },
  {
   "t": 14.68,
   "text": "Sábado y domingo"
  },
  {
   "t": 18.66,
   "text": "¡Siete días tiene la semana!"
  },
  {
   "t": 24.04,
   "text": "Lunes voy a la escuela"
  },
  {
   "t": 29.34,
   "text": "Martes juego con mi perro"
  },
  {
   "t": 34.66,
   "text": "Miércoles pinto un dibujo"
  },
  {
   "t": 45.3,
   "text": "Jueves canto esta canción"
  },
  {
   "t": 48.02,
   "text": "Viernes abrazo a mamá"
  },
  {
   "t": 50.68,
   "text": "Sábado y domingo, ¡a descansar!"
  },
  {
   "t": 54.06,
   "text": "Lunes, martes, miércoles, jueves, viernes, sábado, domingo"
  }
 ]
}