{
 "lines": [
  {
   "text": "A, E, I, O, U"
  },
  {
   "text": "¡Las vocales canto yo!"
  },
  {
   "text": "A de avión que vuela alto"
  },
  {
   "text": "E de elefante, ¡qué grandote!"
  },
  {
   "text": "I de iguana en la rama"
  },
  {
   "text": "O de oso que se abraza"
  },
  {
   "text": "U de uva dulce y rica"
  },
  {
   "text": "A, E, I, O, U"
  },
  {
   "text": "¡Las vocales ya sé yo!"
  },
  {
   "text": "A, E, I, O, U"
  },
  {
   "text": "¡Cántalas conmigo tú!"
  }
 ]
}