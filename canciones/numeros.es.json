{
 "lines": [
  {
   "text": "Uno, dos, tres, ¡vamos a contar!"
  },
  {
   "text": "Cuatro, cinco, seis, ¡no voy a parar!"
  },
  {
   "text": "Siete, ocho, nueve, ¡casi llego al fin!"
  },
  {
   "text": "¡Diez! ¡Conté hasta diez!"
  },
  {
   "text": "Un sol, dos manos, tres pollitos"
  },
  {
   "text": "Cuatro patas, cinco deditos"
  },
  {
   "text": "Seis globos, siete estrellas"
  },
  {
   "text": "Ocho peces, nueve flores"
  },
  {
   "text": "¡Y diez abrazos para ti!"
  },
  {
   "text": "Uno, dos, tres, cuatro, cinco"
  },
  {
   "text": "Seis, siete, ocho, nueve, ¡diez!"
  }
 ]
}